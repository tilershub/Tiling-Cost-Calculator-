---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import tilersData from '../data/tilers.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://tilershub.lk/#business",
  "name": "TILERSHUB",
  "description": "Sri Lanka's #1 tiling and bathroom service platform.",
  "url": "https://tilershub.lk",
  "telephone": "+94774503744",
  "address": { "@type": "PostalAddress", "addressCountry": "LK" },
  "openingHours": "Mo-Su 08:00-20:00",
  "priceRange": "Rs. 120 - Rs. 3000",
  "serviceArea": { "@type": "Country", "name": "Sri Lanka" },
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "150" }
};

// Featured tilers for homepage
const featured = tilersData
  .filter(t => t.featured)
  .slice(0, 6);

function stars(r: number) {
  const n = Math.round(r);
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<Layout
  title="TILERSHUB – Sri Lanka's #1 Tiling & Bathroom Service Platform"
  description="TILERSHUB offers professional tiling and bathroom renovation services in Sri Lanka. Certified tilers, transparent rates, 1-year warranty."
  canonical="https://tilershub.lk/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero" aria-label="Hero">
      <div class="hero-content">
        <h1>TILERSHUB – Tiling &amp; Bathroom Experts</h1>
        <p class="hero-subtitle">Certified Tilers · Transparent Rates · 1-Year Warranty</p>
        <a href="/tilers" class="cta-btn">Find a Certified Tiler →</a>

        <div class="hero-features">
          <div class="feature">
            <div class="feature-icon">⚡</div>
            <p class="feature-text">Fast Service</p>
          </div>
          <div class="feature">
            <div class="feature-icon">✅</div>
            <p class="feature-text">Certified Tilers</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🛡️</div>
            <p class="feature-text">1-Year Warranty</p>
          </div>
          <div class="feature">
            <div class="feature-icon">💰</div>
            <p class="feature-text">Fair Pricing</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="section" style="background: var(--light-gray); padding: 3rem 2rem;">
      <div class="stats-wrap">
        <div class="stat-item">
          <div class="stat-num">50+</div>
          <div class="stat-label">Verified Tilers</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">4.9★</div>
          <div class="stat-label">Average Rating</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">25+</div>
          <div class="stat-label">Cities Covered</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">1yr</div>
          <div class="stat-label">Warranty</div>
        </div>
      </div>
    </section>

    <!-- Featured Tilers -->
    <section class="section" style="padding: 4rem 2rem;">
      <div class="container">
        <div class="section-header">
          <h2>Featured Certified Tilers</h2>
          <p>Handpicked, verified professionals across Sri Lanka</p>
        </div>
        <div class="cards-grid">
          {featured.map(t => (
            <article class="m-card project-tile" aria-label={t.name}>
              <a class="thumb-wrap" href={`/tilers/${t.id}`} aria-label={`${t.name} profile`}>
                <img class="thumb" src={t.image} alt={`${t.name} tiling work`} loading="lazy" decoding="async" />
                {t.featured && <span class="chip chip--primary chip--featured">Featured</span>}
              </a>
              <div class="tile-body">
                <a class="tile-title" href={`/tilers/${t.id}`}>{t.name}</a>
                <div class="tile-meta">Verified · {t.city}</div>
                <div class="tile-rating">
                  <span class="stars">{stars(t.rating ?? 0)}</span>
                  <span>({(t.rating ?? 0).toFixed(1)})</span>
                  <span>· {t.reviewCount} reviews</span>
                </div>
                <div class="tile-actions">
                  <a class="btn btn--filled" href={`/tilers/${t.id}`}>Book Now</a>
                  <a class="btn btn--tonal" href={`/tilers/${t.id}`}>Profile</a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div style="text-align:center; margin-top: 2rem;">
          <a class="cta-btn" href="/tilers">View All Tilers →</a>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="section" style="background: var(--light-gray); padding: 4rem 2rem;">
      <div class="container">
        <div class="section-header">
          <h2>How It Works</h2>
          <p>3 simple steps to your perfect tiling project</p>
        </div>
        <div class="how-steps">
          <div class="step">
            <div class="step-num">1</div>
            <div class="step-title">Use the Estimator</div>
            <p class="step-desc">Get an instant cost estimate for your project based on area, tile size and materials.</p>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <div class="step-title">Find a Certified Tiler</div>
            <p class="step-desc">Browse our directory of TILERSHUB-certified professionals near you.</p>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <div class="step-title">Get It Done</div>
            <p class="step-desc">Contact your tiler directly via WhatsApp and enjoy a 1-year warranty on workmanship.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Estimator CTA -->
    <section class="section" style="padding: 4rem 2rem; text-align: center;">
      <div class="container">
        <h2 style="font-size: 1.8rem; color: var(--navy); margin-bottom: 1rem;">🧮 Try Our Cost Estimator</h2>
        <p style="color: var(--text-gray); margin-bottom: 1.5rem; max-width: 500px; margin-left: auto; margin-right: auto;">
          Calculate materials, labour and total cost for your tiling project in seconds.
        </p>
        <a class="cta-btn" href="/estimator">Calculate Now →</a>
      </div>
    </section>

    <!-- Service Areas -->
    <section class="section" style="background: var(--light-gray); padding: 3rem 2rem;">
      <div class="container">
        <div class="section-header">
          <h2>We Cover All of Sri Lanka</h2>
        </div>
        <div class="tags-cloud">
          {['Colombo','Galle','Kandy','Matara','Gampaha','Kalutara','Anuradhapura','Kurunegala','Ratnapura','Badulla','Trincomalee','Jaffna','Batticaloa','Ampara','Hambantota','Monaragala'].map(city => (
            <a href="/tilers" class="tag">{city}</a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- WhatsApp Float -->
  <a
    href="https://wa.me/94774503744"
    class="wa-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contact us on WhatsApp"
  >💬</a>

  <Footer />
</Layout>

<style>
  .wa-float {
    position: fixed;
    bottom: 24px; right: 24px;
    background: #25d366;
    color: white;
    width: 58px; height: 58px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem;
    box-shadow: 0 4px 16px rgba(37,211,102,0.45);
    z-index: 900;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .wa-float:hover { transform: scale(1.08); }
</style>
