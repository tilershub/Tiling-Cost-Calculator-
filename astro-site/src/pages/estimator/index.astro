---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TilingCalculator from '../../components/TilingCalculator.svelte';
---

<Layout
  title="Tiling Cost Estimator | TILERSHUB"
  description="Calculate your tiling project cost instantly. Enter area, tile size and price to get a full material and labour estimate for Sri Lanka."
>
  <Header />
  <main>
    <div style="padding: 2rem 0;">
      <TilingCalculator client:load />
    </div>
  </main>
  <Footer />
</Layout>
