---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import tilersData from '../../data/tilers.json';

function stars(r: number) {
  const n = Math.round(r ?? 0);
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}

const tilers = tilersData.slice().sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return (b.rating ?? 0) - (a.rating ?? 0);
});
---

<Layout
  title="Find Certified Tilers in Sri Lanka | TILERSHUB"
  description="Browse TILERSHUB's directory of verified, certified tilers across Sri Lanka. Read reviews, check ratings and contact via WhatsApp."
>
  <Header />
  <main>
    <div class="tilers-section">
      <h1>Find a Certified Tiler</h1>
      <p class="subtitle">Browse {tilers.length}+ verified tiling professionals across Sri Lanka.</p>

      <div class="cards-grid">
        {tilers.map(t => (
          <article class="m-card project-tile" aria-label={t.name}>
            <a class="thumb-wrap" href={`/tilers/${t.id}`}>
              <img class="thumb" src={t.image} alt={`${t.name}`} loading="lazy" decoding="async" />
              {t.featured && <span class="chip chip--primary chip--featured">Featured</span>}
            </a>
            <div class="tile-body">
              <a class="tile-title" href={`/tilers/${t.id}`}>{t.name}</a>
              <div class="tile-meta">Verified · {t.city}</div>
              <div class="tile-rating">
                <span class="stars">{stars(t.rating ?? 0)}</span>
                <span>({(t.rating ?? 0).toFixed(1)})</span>
                <span>· {t.reviewCount} reviews</span>
              </div>
              {t.highlights && (
                <div class="tags-row">
                  {t.highlights.slice(0, 2).map((h: string) => (
                    <span class="highlight-tag">{h}</span>
                  ))}
                </div>
              )}
              <div class="tile-actions">
                <a class="btn btn--filled" href={`/tilers/${t.id}`}>Book Now</a>
                <a class="btn btn--tonal" href={`/tilers/${t.id}`}>Profile</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .tags-row { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
</style>
